# Database: leave unset locally to use SQLite (sqlite:///./local.db).
# On Railway, reference the Postgres plugin: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Required as the X-API-Key header on POST/PUT/DELETE /patients.
API_KEY=change-me-long-random-string

# Shared secret Vapi sends on every webhook (x-vapi-secret or Authorization: Bearer).
VAPI_WEBHOOK_SECRET=change-me-another-long-random-string

# Used only by scripts/vapi_setup.py, never by the running server.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Optional
SEED_ON_STARTUP=true
LOG_LEVEL=INFO
CLINIC_TIMEZONE=America/New_York
